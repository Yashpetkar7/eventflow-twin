{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web/", "framework": "nextjs" },
    "api": { "root": "./", "entrypoint": "apps.api.eventflow.vercel_entry:app" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
