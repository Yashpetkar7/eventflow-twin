# Optional live LLM steps in the planner (agents/llm.py). Fill ONE provider's key; never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model id your key can use, e.g. gpt-5 (OpenAI) or claude-opus-5-5 (Anthropic). Provider is taken from the id,
# or set LLM_PROVIDER=openai|anthropic. Check the provider's model list before setting.
LLM_MODEL=
LLM_PROVIDER=
DEMO_MODE=offline        # offline | live
DATA_MODE=synthetic      # synthetic | real
